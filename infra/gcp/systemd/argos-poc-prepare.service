[Unit]
Description=Load the current Argos PoC release's secrets before Docker restores its containers
Wants=network-online.target
After=network-online.target
Before=docker.service
RequiresMountsFor=/srv/argos-poc
ConditionPathExists=/srv/argos-poc/current/release.env

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/root
Environment=CLOUDSDK_CORE_DISABLE_PROMPTS=1
Environment=CLOUDSDK_CORE_LOG_HTTP=False
ExecStart=/usr/local/lib/argos-poc/load-secrets.py --release /srv/argos-poc/current
TimeoutStartSec=5min
